# Copiar este archivo como .env y completar los valores. El archivo .env nunca se sube al repositorio.

# --- Django ---
EPS_CLAVE_SECRETA=cambiar-por-una-clave-larga-y-aleatoria
EPS_DEPURACION=True
EPS_HOSTS_PERMITIDOS=localhost,127.0.0.1
EPS_ORIGENES_CORS=http://localhost:5173
EPS_MINUTOS_VIGENCIA_TOKEN=60

# Producción (solo aplican con EPS_DEPURACION=False): HTTPS obligatorio, HSTS y orígenes confiables.
EPS_REDIRIGIR_HTTPS=True
EPS_HSTS_SEGUNDOS=31536000
EPS_ORIGENES_CONFIABLES=

# --- PostgreSQL ---
EPS_BD_NOMBRE=eps_citas
EPS_BD_USUARIO=eps_app
EPS_BD_CLAVE=
EPS_BD_HOST=localhost
EPS_BD_PUERTO=5432

# Réplica de solo lectura para reportes (opcional). Vacío = los reportes leen de la base principal.
EPS_BD_REPLICA_HOST=
EPS_BD_REPLICA_PUERTO=5433
EPS_BD_REPLICA_USUARIO=eps_lectura
EPS_BD_REPLICA_CLAVE=

# Tablespaces (Administración de Bases de Datos). Vacíos = tablespace por defecto.
EPS_BD_TABLESPACE_DATOS=
EPS_BD_TABLESPACE_INDICES=

# --- Correo de notificaciones ---
# Consola = los correos se imprimen en la terminal de runserver (desarrollo).
# Para enviar de verdad: django.core.mail.backends.smtp.EmailBackend y completar servidor, usuario y clave.
EPS_CORREO_BACKEND=django.core.mail.backends.console.EmailBackend
EPS_CORREO_REMITENTE=Citas EPS <no-responder@eps.test>
EPS_CORREO_SERVIDOR=
EPS_CORREO_PUERTO=587
EPS_CORREO_USUARIO=
EPS_CORREO_CLAVE=
EPS_CORREO_TLS=True

# --- Tareas en segundo plano ---
# Inmediato en desarrollo. En producción, un backend con cola y un worker.
EPS_TAREAS_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# --- Parámetros del sistema de agendamiento ---
EPS_ZONA_HORARIA=America/Bogota
EPS_DURACION_CITA_MINUTOS=20
EPS_HORAS_MINIMAS_CANCELACION=2
EPS_MAXIMO_CITAS_ACTIVAS_PACIENTE=3

# Inicio de sesión: tras N intentos fallidos la cuenta se bloquea temporalmente (riesgo R5).
EPS_INTENTOS_MAXIMOS_SESION=5
EPS_MINUTOS_BLOQUEO_SESION=15

# Recordatorios: se avisa al paciente estas horas antes de la cita (comando enviar_recordatorios).
EPS_HORAS_ANTICIPACION_RECORDATORIO=24

# --- Datos sintéticos de demostración (comando sembrar_datos) ---
# Contraseña común de las cuentas ficticias. Solo para desarrollo: no reutilizarla en ningún otro lugar.
EPS_CLAVE_USUARIOS_DEMO=
